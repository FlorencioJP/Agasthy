{
  "name": "@agasthy/demo-video",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The README demo video, rendered with Remotion from synthetic demo screenshots.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Demo out/agasthy-demo.mp4 --codec=h264 --crf=20",
    "typecheck": "tsc --noEmit",
    "gif": "bash make-gif.sh"
  },
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "6.0.3"
  }
}
